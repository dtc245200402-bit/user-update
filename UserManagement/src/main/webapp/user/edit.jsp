<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Sửa User</title><style>body{font-family:Arial;background:#f4f7fb}.box{width:450px;margin:60px auto;background:white;padding:30px;border-radius:12px}input{width:100%;padding:10px;margin:7px 0 15px;box-sizing:border-box}button{width:100%;padding:11px;background:#2980b9;color:white;border:0;border-radius:6px}</style></head><body><div class="box"><h2>Sửa User</h2><form action="${pageContext.request.contextPath}/users?action=edit" method="post"><input type="hidden" name="id" value="${user.id}"><label>Tên</label><input name="name" value="${user.name}" required><label>Email</label><input type="email" name="email" value="${user.email}" required><label>Quốc gia</label><input name="country" value="${user.country}"><button>Cập nhật</button></form><p><a href="${pageContext.request.contextPath}/users">Quay lại</a></p></div></body></html>
