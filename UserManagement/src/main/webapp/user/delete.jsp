<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Xóa User</title><style>body{font-family:Arial;background:#f4f7fb;text-align:center}.box{width:430px;margin:80px auto;background:white;padding:30px;border-radius:12px}.del{background:#c0392b;color:white;border:0;padding:10px 20px;border-radius:6px}.cancel{padding:10px 20px}</style></head><body><div class="box"><h2>Xác nhận xóa</h2><p>Bạn có chắc muốn xóa User này?</p><p><b>${user.name}</b> - ${user.email}</p><form action="${pageContext.request.contextPath}/users?action=delete" method="post"><input type="hidden" name="id" value="${user.id}"><button class="del">Đồng ý xóa</button> <a class="cancel" href="${pageContext.request.contextPath}/users">Hủy</a></form></div></body></html>
