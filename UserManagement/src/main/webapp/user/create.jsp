<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Thêm User</title><style>body{font-family:Arial;background:#f4f7fb}.box{width:450px;margin:60px auto;background:white;padding:30px;border-radius:12px}input{width:100%;padding:10px;margin:7px 0 15px;box-sizing:border-box}button{width:100%;padding:11px;background:#27ae60;color:white;border:0;border-radius:6px}</style></head><body><div class="box"><h2>Thêm User</h2><form action="${pageContext.request.contextPath}/users?action=create" method="post"><label>Tên</label><input name="name" required><label>Email</label><input type="email" name="email" required><label>Quốc gia</label><input name="country"><button>Lưu</button></form><p><a href="${pageContext.request.contextPath}/users">Quay lại</a></p></div></body></html>
